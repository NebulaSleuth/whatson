<?xml version="1.0" encoding="utf-8" ?>
<!--
  ApiTask — single-shot HTTP request, runs on a background thread so the
  render thread stays responsive.

  Inputs:    url, method ("GET" | "POST" | "PUT" | "DELETE"), body, headers
  Output:    response (parsed JSON, or { success: false, error } on failure)

  Every screen builds one of these per request, observes `response`, and
  reads it in the callback. Headers can be augmented with the per-request
  user / connection-type values before kicking off `control = "RUN"`.
-->
<component name="ApiTask" extends="Task">
    <script type="text/brightscript" uri="ApiTask.brs" />

    <interface>
        <field id="url" type="string" />
        <field id="method" type="string" value="GET" />
        <field id="body" type="string" />
        <field id="userId" type="string" />
        <!--
          Determines which user header to send. Default 'plex' preserves
          legacy behaviour. Set to 'whatson' when the Whats On Users
          feature is on and the selected user is a Whats On profile.
        -->
        <field id="userKind" type="string" value="plex" />
        <field id="connectionType" type="string" value="local" />
        <field id="authKey" type="string" />
        <!--
          PIN session token minted by POST /whatson-users/:id/select. Sent
          as X-Whatson-Session so PIN-protected Whats On users can't be
          acted-as by merely asserting X-Whatson-User (userContext.ts
          verifies it; hard 401 once WHATSON_STRICT_PIN is on).
        -->
        <field id="sessionToken" type="string" />
        <!--
          Per-request wait ceiling in milliseconds. Default 60s matches
          the backend's ARR_TIMEOUT. Boot probes (admin-status, candidate
          /health checks) pass a short value so an unreachable host fails
          fast instead of freezing boot for a minute.
        -->
        <field id="timeoutMs" type="integer" value="60000" />
        <field id="response" type="assocarray" />
    </interface>
</component>
