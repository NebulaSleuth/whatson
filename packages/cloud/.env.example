# Whats On Cloud — control plane config. See README.md.

# HTTP + WSS port.
PORT=4000

# Base cloud domain. Per-server hostnames are <serverId>.s.<CLOUD_DOMAIN>
# (Plex plex.direct pattern); the DNS-01 cert zone is s.<CLOUD_DOMAIN>.
CLOUD_DOMAIN=whatsontv.net

# Where the JSON store + the cloud signing key are persisted.
CLOUD_DATA_DIR=./data

# TTL (seconds) for the candidate list handed to apps.
CANDIDATE_TTL=300

# Lifetime (seconds) of a signed device grant. Short — it's used once at pairing.
GRANT_TTL=600

# Lifetime (seconds) of an account session token.
SESSION_TTL=2592000
