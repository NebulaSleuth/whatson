# Whats On Cloud — control plane config. See README.md.

# HTTP + WSS port.
PORT=4000

# Base cloud domain. Per-server hostnames are <serverId>.s.<CLOUD_DOMAIN>
# (Plex plex.direct pattern); the DNS-01 cert zone is s.<CLOUD_DOMAIN>.
CLOUD_DOMAIN=whatsontv.net

# Where the JSON store + the cloud signing key are persisted.
CLOUD_DATA_DIR=./data

# Azure DNS publishing (M8): the cloud writes <serverId>.s.<domain> A/AAAA
# records to a hosted zone on heartbeat, so apps reach a backend by a
# cert-matching hostname. Auth is the App Service managed identity (DNS Zone
# Contributor on the zone) — no secret here. Dormant unless BOTH are set AND an
# MSI is present. Zone defaults to s.<CLOUD_DOMAIN>.
CLOUD_DNS_SUBSCRIPTION_ID=
CLOUD_DNS_RESOURCE_GROUP=
# CLOUD_DNS_ZONE=s.whatsontv.net
# CLOUD_DNS_TTL=60

# TTL (seconds) for the candidate list handed to apps.
CANDIDATE_TTL=300

# Lifetime (seconds) of a signed device grant. Short — it's used once at pairing.
GRANT_TTL=600

# Lifetime (seconds) of an account session token.
SESSION_TTL=2592000
