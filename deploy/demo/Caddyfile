{
	email {$ACME_EMAIL}
}

{$DEMO_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Attribution for the CC-BY and public-domain media (generated by
	# content/fetch.sh, copied to site/credits.html).
	handle /credits {
		root * /srv/site
		rewrite * /credits.html
		file_server
	}

	# Everything else: the web app, /api and /ws (WebSocket upgrades pass through).
	handle {
		reverse_proxy whatson-api:3001
	}

	log {
		output stdout
		format console
	}
}
