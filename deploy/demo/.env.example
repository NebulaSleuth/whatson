# Copy to .env on the demo VM and fill in. Never commit the filled-in file.

# Public hostname (needs an A record pointing at the VM; provision.sh adds it).
DEMO_DOMAIN=demo.whatsontv.net

# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=

# Password for the restricted Jellyfin "demo" account the backend signs in as.
# setup-jellyfin.sh creates that account with this password.
JELLYFIN_DEMO_PASSWORD=

# Where content/fetch.sh put the media on the VM (mounted read-only into Jellyfin).
MEDIA_DIR=/srv/media

# Optional: TMDB API key, enables Discover and richer artwork.
TMDB_API_KEY=
